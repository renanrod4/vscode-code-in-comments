{
	"name": "vscode-code-in-comments",
	"displayName": "CodeInComments",
	"description": "Highlight code blocks inside comments in VSCode!",
	"version": "0.5.0",
	"publisher": "renanrod",
	"author": {
		"name": "Renan Rodrigues de Meneses",
		"email": "renanrdemeneses@gmail.com",
		"url": "https://renanrod.vercel.app"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/renanrod4/vscode-comment-code-blocks.git"
	},
	"homepage": "https://github.com/renanrod4/vscode-comment-code-blocks",
	"bugs": {
		"url": "https://github.com/renanrod4/vscode-comment-code-blocks/issues"
	},
	"license": "SEE LICENSE IN LICENSE",
	"icon": "public/icon.png",
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:javascript",
		"onLanguage:javascriptreact",
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:rust",
		"onLanguage:python",
		"onLanguage:go",
		"onLanguage:lua",
		"onLanguage:cpp"
	],
	"engines": {
		"vscode": "^1.39.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"highlight",
		"comment",
		"markdown",
		"Code blocks",
		"syntax highlighting"
	],
	"contributes": {
		"configurationDefaults": {
			"editor.tokenColorCustomizations": {
				"textMateRules": [
					{
						"scope": "comment.code.block",
						"settings": {
							"foreground": "#D4D4D4"
						}
					}
				]
			}
		},
		"configuration": {
			"title": "CodeInComments",
			"properties": {
				"codeInComments.opacity": {
					"type": "number",
					"default": 0.5,
					"minimum": 0,
					"maximum": 1,
					"description": "Opacity applied to code blocks inside comments."
				},
				"codeInComments.grayscale": {
					"type": "number",
					"default": 25,
					"minimum": 0,
					"maximum": 100,
					"description": "Grayscale percentage applied to code blocks inside comments."
				},
				"codeInComments.enableAbbreviations": {
					"type": "boolean",
					"default": false,
					"description": "Enable $ as an abbreviation for @code in line and block comments."
				},
				"codeInComments.preserveNestedComments": {
					"type": "boolean",
					"default": true,
					"description": "Keep comments inside highlighted code at their normal color and effects."
				}
			}
		},
		"grammars": [
			{
				"scopeName": "source.comment.message.javascript",
				"path": "./syntaxes/comment.message.javascript.json",
				"injectTo": [
					"source.js"
				]
			},
			{
				"scopeName": "source.comment.message.javascriptreact",
				"path": "./syntaxes/comment.message.javascriptreact.json",
				"injectTo": [
					"source.js.jsx"
				]
			},
			{
				"scopeName": "source.comment.message.typescript",
				"path": "./syntaxes/comment.message.typescript.json",
				"injectTo": [
					"source.ts"
				]
			},
			{
				"scopeName": "source.comment.message.typescriptreact",
				"path": "./syntaxes/comment.message.typescriptreact.json",
				"injectTo": [
					"source.ts",
					"source.tsx"
				]
			},
			{
				"scopeName": "source.comment.message.rust",
				"path": "./syntaxes/comment.message.rust.json",
				"injectTo": [
					"source.rust"
				]
			},
			{
				"scopeName": "source.comment.message.python",
				"path": "./syntaxes/comment.message.python.json",
				"injectTo": [
					"source.python"
				]
			},
			{
				"scopeName": "source.comment.message.go",
				"path": "./syntaxes/comment.message.go.json",
				"injectTo": [
					"source.go"
				]
			},
			{
				"scopeName": "source.comment.message.cpp",
				"path": "./syntaxes/comment.message.cpp.json",
				"injectTo": [
					"source.cpp"
				]
			},
			{
				"scopeName": "source.comment.message.lua",
				"path": "./syntaxes/comment.message.lua.json",
				"injectTo": [
					"source.lua"
				]
			}
		]
	},
	"devDependencies": {
		"@types/node": "^10.5.1",
		"@vscode/vsce": "^4.0.0",
		"vscode": "^1.1.36"
	},
	"scripts": {
		"test": "node --test test/marker-ranges.test.js",
		"build": "vsce package"
	}
}

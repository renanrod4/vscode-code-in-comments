{
	"$schema": "https://raw.githubusercontent.com/RedCMD/TmLanguage-Syntax-Highlighter/main/vscode.tmLanguage.schema.json",
	"scopeName": "source.comment.message.rust",
	"injectionSelector": "L:source.rust",
	"patterns": [
		{
			"begin": "^[ \\t]*//[ \\t]*@code(?!\\()\\s*",
			"end": "$",
			"contentName": "comment.code.block meta.embedded.block.rust",
			"patterns": [{ "include": "source.rust" }]
		},
		{
			"begin": "^[ \\t]*//[ \\t]*@code\\(rust\\)\\s*",
			"end": "$",
			"contentName": "comment.code.block meta.embedded.block.rust",
			"patterns": [{ "include": "source.rust" }]
		},
		{
			"begin": "@code(?!\\()\\s*",
			"end": "(?=\\*\\/)",
			"contentName": "comment.code.block meta.embedded.block.rust",
			"patterns": [{ "include": "source.rust" }]
		},
		{
			"begin": "@code\\(rust\\)\\s*",
			"end": "(?=\\*\\/)",
			"contentName": "comment.code.block meta.embedded.block.rust",
			"patterns": [{ "include": "source.rust" }]
		}
	]
}
